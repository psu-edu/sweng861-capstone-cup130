# Campus Rental - Local Development Environment

# Backend
SERVER_PORT=3000

# Frontend
CLIENT_PORT=4200

# PostgreSQL
# Used by the PostgreSQL container and by local backend development.
POSTGRES_DB=campus_rental
POSTGRES_USER=campus_rental
POSTGRES_PASSWORD=campus_rental_dev
POSTGRES_HOST_PORT=5432

# Automated testing
# If omitted locally, tests default to <POSTGRES_DB>_test.
POSTGRES_TEST_DB=campus_rental_test

# Auth0
# Domain should not include https://.
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Identifier configured for the Campus Rental API in Auth0.
AUTH0_AUDIENCE=https://api.campus-rental.local

# AI-assisted roommate matching
#
# mock:
# Uses the deterministic local provider.
#
# remote:
# Uses the configured OpenAI-compatible chat-completions endpoint.
# If the remote configuration is unavailable or a request fails,
# Campus Rental automatically falls back to the deterministic provider.
AI_PROVIDER=mock

# Penn State DRIFT endpoint.
# This URL is not an API key.
AI_BASE_URL=http://ec2-13-59-66-30.us-east-2.compute.amazonaws.com:8091

AI_MODEL=drift

# Never commit a real API key.
AI_API_KEY=

AI_MAX_TOKENS=200
AI_TIMEOUT_MS=20000